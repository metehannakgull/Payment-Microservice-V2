{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },

  "Console": {
    "IncludeScopes": true
  },

  "AllowedHosts": "*",

  "Persistence": {
    "Provider": "SqlServer"
  },

  "Messaging": {
    "Provider": "RabbitMq",

    "RabbitMq": {
      "HostName": "127.0.0.1",
      "Port": 5673,
      "UserName": "guest",
      "Password": "guest",
      "VirtualHost": "/",
      "ExchangeName": "payment.events"
    }
  },

  "ConnectionStrings": {
    "PaymentDatabase": "Server=.;Database=PaymentDb;Trusted_Connection=True;TrustServerCertificate=True;"
  }
}