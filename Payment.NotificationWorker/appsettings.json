{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Console": {
    "IncludeScopes": true
  },
  "ConnectionStrings": {
    "NotificationDatabase": "Server=.;Database=NotificationDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "RabbitMq": {
    "HostName": "127.0.0.1",
    "Port": 5673,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",

    "ExchangeName": "payment.events",
    "QueueName": "notification.payment.completed",
    "RoutingKey": "payment.completed",

    "RetryExchangeName": "notification.retry",
    "RetryQueueName": "notification.payment.completed.retry",
    "RetryRoutingKey": "notification.payment.completed.retry",
    "RetryDelayMilliseconds": 5000,
    "MaxRetryCount": 3,

    "DeadLetterExchangeName": "notification.dlx",
    "DeadLetterQueueName": "notification.payment.completed.dlq",
    "DeadLetterRoutingKey": "notification.payment.completed.dead"
  }
}